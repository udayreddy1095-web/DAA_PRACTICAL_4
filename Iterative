import time

# Iterative Factorial
def factorial_iterative(n):
    result = 1
    for i in range(1, n+1):
        result *= i
    return result

# Time Analysis
n = 10
start = time.time()
fact_iter = factorial_iterative(n)
end = time.time()

print("Iterative Factorial of", n, ":", fact_iter)
print("Iterative Time:", end - start, "seconds")
